{
  "name": "hyper-do",
  "productName": "Hyper Do",
  "version": "0.1.0",
  "description": "ADHD-friendly personal to-do that keeps reminding you until the task is done",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "dist": "npm run build && electron-builder --win --config.directories.output=%LOCALAPPDATA%/hyperdo-release",
    "dist:mac": "npm run build && electron-builder --mac",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "android:apk": "npm run android:sync && cd android && gradlew assembleDebug"
  },
  "build": {
    "appId": "com.hyperdo.app",
    "productName": "Hyper Do",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Hyper-Do-Setup-${version}.${ext}",
      "uninstallDisplayName": "Hyper Do",
      "shortcutName": "Hyper Do"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^40.10.2",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
