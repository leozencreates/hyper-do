{
  "manifest_version": 3,
  "name": "Hyper Do",
  "version": "0.1.0",
  "description": "ADHD-friendly to-do that keeps reminding you until the task is done.",
  "icons": {
    "16": "icon-192.png",
    "48": "icon-192.png",
    "128": "icon-192.png"
  },
  "action": {
    "default_title": "Hyper Do",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-192.png",
      "48": "icon-192.png",
      "128": "icon-192.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "contextMenus", "tabs"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
